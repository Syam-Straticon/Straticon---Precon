# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Claude API key — console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use
CLAUDE_MODEL=claude-opus-5-5

# Autodesk Platform Services app — aps.autodesk.com → Applications
# Create an app with the "Data Management API" enabled.
# For ACC/BIM 360 data, an account admin must add this app under
# Account Admin → Settings → Custom Integrations.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Microsoft (SharePoint/Teams) — Entra app registration with application
# permissions Sites.ReadWrite.All (admin-consented)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

PORT=3001

# Vercel only: injected automatically when you connect a Vercel Postgres (Neon) database.
# Leave unset for local npm start — data then lives in local files next to the code.
POSTGRES_URL=
